#!/usr/bin/env bash
# Run a command inside the weektodo-dev toolbox container with the
# project-local Flutter SDK on PATH.
#
#   tools/dev flutter test
#   tools/dev flutter build linux --release
#   tools/dev dart format lib
#
# The container holds the compiler toolchain and GTK headers, so the host
# needs no development packages. Create it once with tools/setup-dev.sh.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
container="${WEEKTODO_CONTAINER:-weektodo-dev}"
# The Flutter release is pinned in tools/flutter-version; see the note there
# in the README before raising it.
version="${FLUTTER_VERSION:-$(cat "$root/tools/flutter-version")}"
sdk="$root/.tools/sdk-$version/flutter"
[ -x "$sdk/bin/flutter" ] || { echo "Flutter $version is not installed; run tools/setup-dev.sh" >&2; exit 1; }
exec toolbox run -c "$container" env \
  PATH="$sdk/bin:/usr/local/bin:/usr/bin:/bin" \
  PUB_CACHE="$root/.tools/pub-cache" \
  FLUTTER_SUPPRESS_ANALYTICS=true \
  DART_SUPPRESS_ANALYTICS=true \
  CI=true \
  bash -c 'cd "$1" && shift && exec "$@"' _ "${WEEKTODO_CWD:-$root}" "$@"
