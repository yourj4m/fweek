<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied by system backups or phone-to-phone transfers. The
     planner file carries this device's identity for sync, so a restored copy
     would pose as the same device; use sync or Settings > Export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
